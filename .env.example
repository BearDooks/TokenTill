# OpenWebUI Instance Configuration
# URL of your OpenWebUI instance (e.g. https://ai.yourdomain.com or http://localhost:3000)
OPENWEBUI_URL=http://localhost:3000

# OpenWebUI API Key (Generated in OpenWebUI -> Settings -> Account -> API Keys)
# Keep this in your .env file; it will remain completely private and never be exposed to clients
OPENWEBUI_API_KEY=

# Server Port (Default: 3001)
PORT=3001

# Cache time in minutes to prevent excessive calls to OpenWebUI
CACHE_TTL_MINUTES=5

# Privacy & Masking Settings (true / false)
# When enabled, names like "John Smith" are masked to "Jo*** M******"
MASK_USER_NAMES=false

# When enabled, chat topics retain the first category word and mask the rest (e.g. "Compression •••••••••")
MASK_CHAT_TITLES=false
